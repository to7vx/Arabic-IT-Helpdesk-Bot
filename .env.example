# =============================================================================
# Arabic IT Helpdesk Bot — example environment
# Copy to `.env` and fill in. NEVER commit the real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
APP_ENV=development            # development | staging | production
APP_NAME=arabic-helpdesk
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-32-bytes-min
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=helpdesk
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
# Pre-rendered URL used by SQLAlchemy/Alembic:
DATABASE_URL=postgresql+asyncpg://helpdesk:change-me@localhost:5432/helpdesk

# -----------------------------------------------------------------------------
# Redis (broker + cache + pub/sub)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO in dev)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=helpdesk-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# -----------------------------------------------------------------------------
# Vector store
# -----------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Multi-tenancy
# -----------------------------------------------------------------------------
MULTI_TENANT=false
DEFAULT_ORG_SLUG=default

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# OAuth providers (leave blank to disable)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common

# SAML (leave blank to disable)
SAML_METADATA_URL=
SAML_ENTITY_ID=

# -----------------------------------------------------------------------------
# NLP / LLM
# -----------------------------------------------------------------------------
# Provider: disabled | claude | jais
# Default is `disabled` so first-run never makes a cross-border call.
LLM_PROVIDER=disabled

# Anthropic Claude (when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_PROMPT_CACHE=true

# Jais self-hosted (when LLM_PROVIDER=jais)
JAIS_BASE_URL=http://localhost:11434
JAIS_MODEL=jais-30b-chat

# Embedding model
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Confidence thresholds
NLP_CATEGORY_MIN_CONFIDENCE=0.55
NLP_URGENCY_THRESHOLD=0.75

# -----------------------------------------------------------------------------
# Email ingest (IMAP)
# -----------------------------------------------------------------------------
EMAIL_INGEST_ENABLED=false
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@example.com

# -----------------------------------------------------------------------------
# Integrations (disabled by default — PDPL note: many of these involve cross-border transfer)
# -----------------------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=helpdesk-api
PROMETHEUS_METRICS_PORT=9100

# -----------------------------------------------------------------------------
# Frontend (apps/web)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_AVAILABLE_LOCALES=ar,en
